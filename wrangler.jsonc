{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fracta-flow-vector",
  "compatibility_date": "2026-08-28",
  "main": "./worker/index.js",
  "routes": [
    {
      "pattern": "vector.whatbit.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "STRIPE_PRICE_ID": "price_1U9PtYFIXid8q5ww6023smGl",
    "STRIPE_YEARLY_PRICE_ID": "price_1U9PtfFIXid8q5wwC7q1sAoT",
    "STRIPE_SINGLE_DOCUMENT_PRICE_ID": "price_1U9Pt0FIXid8q5wwDir1g6gO",
    "STRIPE_PORTAL_CONFIGURATION_ID": "bpc_1U9GR1FIXid8q5wwOXKn3Bao"
  },
  "assets": {
    "directory": "./packages/ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vector-commercial",
      "database_id": "21b19052-3c3c-41d4-a80e-c669d81f231a"
    }
  ]
}
