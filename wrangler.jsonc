{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fracta-flow-vector",
  "compatibility_date": "2026-08-28",
  "main": "./worker/index.js",
  "routes": [
    {
      "pattern": "vector.whatbit.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./packages/ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vector-commercial",
      "database_id": "21b19052-3c3c-41d4-a80e-c669d81f231a"
    }
  ]
}
